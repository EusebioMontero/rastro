rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Cada jugador solo puede leer y escribir lo suyo: users/{uid}/rastro/config y users/{uid}/rastro/save
    match /users/{uid}/rastro/{doc} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
