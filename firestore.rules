rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Partida y configuración: solo su dueño
    match /users/{uid}/rastro/{doc} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Mercado entre jugadores
    match /mercado/{id} {
      function d() { return request.resource.data; }
      function o() { return resource.data; }
      function yo() { return request.auth.uid; }
      function solo(ks) { return d().diff(o()).affectedKeys().hasOnly(ks); }
      function texto(v, n) { return v is string && v.size() <= n; }
      function entero(v, a, b) { return v is int && v >= a && v <= b; }

      // Campos opcionales: tipo (mat o plano), pide (plano a cambio), inv (invento de la IA)
      function tipoOk() { return !('tipo' in d()) || d().tipo == 'mat' || (d().tipo == 'plano' && d().cant == 1); }
      function pideOk() { return !('pide' in d()) || texto(d().pide, 20); }
      function invOk() { return !('inv' in d()) || (d().inv is map && d().inv.size() <= 12); }

      allow read: if request.auth != null;

      // Publicar: a tu nombre, abierta y con valores razonables
      allow create: if request.auth != null
        && d().keys().hasOnly(['vendedor', 'alias', 'tipo', 'mat', 'cant', 'precio', 'pide', 'inv', 'estado', 'creada'])
        && d().keys().hasAll(['vendedor', 'alias', 'mat', 'cant', 'precio', 'estado', 'creada'])
        && d().vendedor == yo() && d().estado == 'abierta'
        && texto(d().mat, 20) && texto(d().alias, 40)
        && entero(d().cant, 1, 999) && entero(d().precio, 0, 100000)
        && d().creada is number
        && tipoOk() && pideOk() && invOk();

      // Comprar: una oferta abierta de otro pasa a vendida a tu nombre
      allow update: if request.auth != null
        && o().estado == 'abierta' && o().vendedor != yo()
        && d().estado == 'vendida' && d().comprador == yo()
        && solo(['estado', 'comprador', 'vendidaEn']);

      // Retirar: el vendedor cancela su oferta abierta
      allow update: if request.auth != null
        && o().vendedor == yo() && o().estado == 'abierta'
        && d().estado == 'cancelada' && solo(['estado']);

      // Cobrar: el vendedor marca como cobrada una oferta vendida (una sola vez)
      allow update: if request.auth != null
        && o().vendedor == yo() && o().estado == 'vendida'
        && !('cobrado' in o()) && d().cobrado == true && solo(['cobrado']);

      allow delete: if false;
    }
  }
}
